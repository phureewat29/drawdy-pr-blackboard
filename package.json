{
    "name": "pr-blackboard",
    "version": "1.1.0",
    "description": "Drawdy extension that lays a GitHub PR out as one Drawdy board.",
    "author": "Phureewat A <a.phureewat@gmail.com>",
    "license": "MIT",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "node build.ts",
        "test": "jest",
        "typecheck": "tsc --noEmit",
        "check": "node scripts/check.ts",
        "preview": "node scripts/preview.ts",
        "preview:board": "node scripts/preview-board.ts",
        "icon": "node scripts/icon.ts",
        "worker": "node scripts/worker.ts"
    },
    "devDependencies": {
        "@drawdy/driver-protocol": "^1.3.0",
        "@jest/globals": "^30.5.2",
        "@rollup/plugin-typescript": "^12.1.2",
        "@swc/core": "^1.16.13",
        "@swc/jest": "^0.2.39",
        "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^24",
        "esbuild": "^0.28.2",
        "fflate": "^0.8.2",
        "jest": "^30.5.2",
        "jest-environment-jsdom": "^30.5.2",
        "jsdom": "^30.1.2",
        "rollup": "^4.34.0",
        "tree-sitter-c": "0.24.1",
        "tree-sitter-c-sharp": "0.23.5",
        "tree-sitter-clojure-orchard": "0.2.8",
        "tree-sitter-cpp": "0.23.4",
        "tree-sitter-elixir": "0.3.5",
        "tree-sitter-go": "0.25.0",
        "tree-sitter-haskell": "0.23.1",
        "tree-sitter-java": "0.23.5",
        "tree-sitter-javascript": "0.25.0",
        "tree-sitter-php": "0.24.2",
        "tree-sitter-python": "0.25.0",
        "tree-sitter-ruby": "0.23.1",
        "tree-sitter-rust": "0.24.0",
        "tree-sitter-scala": "0.24.0",
        "tree-sitter-typescript": "0.23.2",
        "tslib": "^2.8.1",
        "typescript": "^5",
        "vite": "^8.2.1",
        "web-tree-sitter": "0.27.1"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/src/**/*.test.ts"
        ],
        "transform": {
            "^.+\\.ts$": [
                "@swc/jest",
                {
                    "jsc": {
                        "parser": {
                            "syntax": "typescript"
                        },
                        "target": "es2022"
                    },
                    "module": {
                        "type": "commonjs"
                    }
                }
            ]
        },
        "watchman": false
    }
}
